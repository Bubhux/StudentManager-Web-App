# Exclure les fichiers et dossiers générés par Python lors de la compilation
__pycache__/
*.pyc

# Exclure le dossier .vscode
.vscode/
.VSCodeCounter

# Exclure le dossier env (environnement virtuel Python)
env/

# Exclure le fichier env
.env

# Exclure les fichiers et dossiers générés par Pytest
.pytest_cache/

# Exclure les fichiers .coveragerc coverage et le dossier coverage_html_report
.coveragerc
.coverage
coverage_html_report/
reports/
node_modules/
